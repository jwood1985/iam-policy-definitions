# dt-vision environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# Anthropic API key (required)
ANTHROPIC_API_KEY=

# Dynatrace tenant — use one of:
DT_TENANT=qof78400          # short tenant ID → https://<id>.apps.dynatrace.com
# DT_ENV=https://qof78400.apps.dynatrace.com   # or full URL

# Dynatrace API token (required for API calls; optional if using SSO only)
DT_TOKEN=

# SSO credentials (optional — used if token-injection fails)
# DT_USERNAME=
# DT_PASSWORD=

# Claude model override (optional — defaults to claude-opus-4-7)
# DT_MODEL=claude-opus-4-7

# Browser options
# DT_HEADLESS=true          # set to false to watch the browser
# DT_MAX_STEPS=15           # cap agentic steps
# DT_ARTIFACTS_DIR=./artifacts   # where screenshots are saved

# ntfy.sh push notifications (optional)
# NTFY_TOPIC=my-ntfy-topic
